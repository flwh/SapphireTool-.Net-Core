                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="5">
                        <ui:TextBlock FontTypography="BodyStrong" Text="禁用锁屏" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
