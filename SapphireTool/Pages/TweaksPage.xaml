                        <ui:TextBlock FontTypography="Caption" Text="切换打印后台处理 开/关" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="tsPrintSpooler" Click="tsPrintSpooler_Click" Grid.Column="1" VerticalAlignment="Top" OffContent="关" OnContent="开" Margin="10"/>
                </Grid>
            </Border>

            <Border Padding="16" Margin="10,0,10,5" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Height="80" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="5">
                        <ui:TextBlock FontTypography="BodyStrong" Text="NoLazyMode" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock FontTypography="Caption" Text="禁用 MMCSS 惰性模式" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="tsNoLazyMode" Click="tsNoLazyMode_Click" Grid.Column="1" VerticalAlignment="Top" OffContent="关" OnContent="开" Margin="10"/>
                </Grid>
            </Border>

            <Border Padding="16" Margin="10,0,10,5" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Height="80" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="5">
                        <ui:TextBlock FontTypography="BodyStrong" Text="管理员账户 UAC" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock FontTypography="Caption" Text="配置管理员账户的 UAC" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="tsUACAdmin" Click="tsUACAdmin_Click" Grid.Column="1" VerticalAlignment="Top" OffContent="关" OnContent="开" Margin="10"/>
                </Grid>
            </Border>

            <Border Padding="16" Margin="10,0,10,5" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Height="80" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="5">
                        <ui:TextBlock FontTypography="BodyStrong" Text="VR" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock FontTypography="Caption" Text="启用 VR 服务" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="tsVR" Click="tsVR_Click" Grid.Column="1" VerticalAlignment="Top" OffContent="关" OnContent="开" Margin="10"/>
                </Grid>
            </Border>

            <Border Padding="16" Margin="10,0,10,5" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Height="80" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="5">
                        <ui:TextBlock FontTypography="BodyStrong" Text="用户账户控制 (UAC)" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock FontTypography="Caption" Text="配置用户账户控制设置" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="tsUAC" Click="tsUAC_Click" Grid.Column="1" VerticalAlignment="Top" OffContent="关" OnContent="开" Margin="10"/>
                </Grid>
            </Border>

            <Border Padding="16" Margin="10,0,10,5" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Height="80" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="5">
                        <ui:TextBlock FontTypography="BodyStrong" Text="禁用开始菜单" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock FontTypography="Caption" Text="切换开始菜单 开/关" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="tsStartMenu" Click="tsStartMenu_Click" Grid.Column="1" VerticalAlignment="Top" OffContent="关" OnContent="开" Margin="10"/>
