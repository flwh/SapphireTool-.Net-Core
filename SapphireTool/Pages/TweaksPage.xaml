                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="5">
                        <ui:TextBlock FontTypography="BodyStrong" Text="禁用 DCOM" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
