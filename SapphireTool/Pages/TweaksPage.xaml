                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="5">
                        <ui:TextBlock FontTypography="BodyStrong" Text="禁用 Hyper-V" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock FontTypography="Caption" Text="切换 Hyper-V 开/关" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="tsHyperV" Click="tsHyperV_Click" Grid.Column="1" VerticalAlignment="Top" OffContent="关" OnContent="开" Margin="10"/>
